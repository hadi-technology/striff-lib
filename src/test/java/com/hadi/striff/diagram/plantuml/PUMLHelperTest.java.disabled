package com.hadi.striff.diagram.plantuml;

import org.junit.Test;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertTrue;

public class PUMLHelperTest {

    @Test
    public void pumlIdIsStableAndUrlSafe() {
        String uniqueName = "module:main";
        String first = PUMLHelper.pumlId(uniqueName);
        String second = PUMLHelper.pumlId(uniqueName);

        assertEquals(first, second);
        assertTrue(first.startsWith("cmp_"));
        assertFalse(first.contains(":"));
        assertFalse(first.contains("."));
        assertFalse(first.contains(" "));
    }

    @Test
    public void pumlIdDecodesBackToUniqueName() {
        String uniqueName = "com.test.ClassA";
        String encoded = PUMLHelper.pumlId(uniqueName);

        assertEquals(uniqueName, PUMLHelper.decodePumlId(encoded));
    }
}
